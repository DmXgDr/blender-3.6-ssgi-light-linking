+static void eevee_light_linking_history_cache_add(EEVEE_Data *vedata, Object *ob)
+{
+  Object *link_object = DRW_object_get_dupli_parent(ob);
+  if (link_object == NULL) {
+    link_object = ob;
+  }
+  const LightLinking *linking = link_object->light_linking;
+  uint64_t receiver = linking ? linking->runtime.receiver_light_set : 0;
+  uint64_t blocker = linking ? linking->runtime.blocker_shadow_set : 0;
+  if (ob->type == OB_LAMP) {
+    linking = ob->light_linking;
+    receiver = linking ? linking->runtime.light_set_membership : UINT64_MAX;
+    blocker = linking ? linking->runtime.shadow_set_membership : UINT64_MAX;
+    if (receiver == UINT64_MAX && blocker == UINT64_MAX) {
+      return;
+    }
+  }
+  else if (receiver == 0 && blocker == 0) {
+    return;
+  }
+
+  /* Use stable original IDs, including the instancer whose rules are inherited.

+
+        scene->eevee.ssr_diffuse_probe_trace = 0;
+        scene->eevee.ssr_diffuse_probe_intensity = 1.0f;
+        scene->eevee.ssr_diffuse_probe_clamp = 1.0f;
+
+        scene->eevee.ssr_diffuse_filter = 1.0f;
